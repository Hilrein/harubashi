{
  "name": "@hilrein/harubashi",
  "version": "0.1.4",
  "description": "Your own personal headless System Use Agent daemon. Let's Haru Haru",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hilrein/harubashi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilrein/harubashi.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/hilrein/harubashi/issues"
  },
  "bin": {
    "harubashi": "./dist/bin.js"
  },
  "files": [
    "dist/**/*",
    "prisma/schema.prisma",
    "prisma/migrations/**/*",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "harubashi": "ts-node -r tsconfig-paths/register src/bin.ts",
    "cli": "ts-node -r tsconfig-paths/register src/bin.ts cli",
    "daemon": "ts-node -r tsconfig-paths/register src/bin.ts daemon",
    "setup": "ts-node -r tsconfig-paths/register src/bin.ts setup",
    "build:run": "nest build && node dist/bin.js",
    "postinstall": "prisma generate",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@inquirer/prompts": "^8.4.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "chokidar": "^4.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "nest-winston": "^1.10.2",
    "openai": "^6.33.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
